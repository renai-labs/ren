DATABASE_URL=postgres://ren:ren@localhost:54320/ren
PORT=4000
# development or test enables local-only shortcuts: logged emails and SKIP_EMAIL_VERIFICATION.
NODE_ENV=development

# Better Auth. Generate a real secret with `openssl rand -base64 32` for anything but local development.
BETTER_AUTH_SECRET=local-development-secret-do-not-use-in-production
BETTER_AUTH_URL=http://localhost:4000
# Comma-separated browser origins allowed to call the API with credentials (the app's dev server).
TRUSTED_ORIGINS=http://localhost:5173
# The app's URL including its /app base path, for links in emails (password reset, invitations).
APP_URL=http://localhost:5173/app
# Where the app finds the API at build time. Defaults to http://localhost:4000 in the dev server.
# VITE_REN_API_URL=http://localhost:4000
# Error tracking. With POSTHOG_PROJECT_KEY (the project's phc_ token) each reported failure and each Error or Fatal log
# becomes a PostHog issue. Brains and executors get this key and PostHog's OTLP endpoint, and nothing else: they
# report their own errors and send their own traces, logs and metrics to PostHog.
# POSTHOG_HOST defaults to US Cloud; EU Cloud is https://eu.i.posthog.com.
# POSTHOG_PROJECT_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# The deployment's name on each error, log and span, for example production. Defaults to development.
# The server image sets REN_VERSION to its commit; elsewhere it defaults to development.
# REN_DEPLOYMENT=development
# Traces, Error and Fatal logs, and metrics go to an OTLP/HTTP backend (JSON), set with the standard OpenTelemetry
# variables. Without an endpoint, a signal goes nowhere. OTEL_EXPORTER_OTLP_ENDPOINT is a base URL: each signal adds
# /v1/<signal>. A signal's own endpoint is the full URL. Headers are comma-separated key=value pairs with URI-encoded
# values. OTEL_TRACES_EXPORTER=none, OTEL_LOGS_EXPORTER=none or OTEL_METRICS_EXPORTER=none turns a signal off. These
# settings, and the keys in their headers, stay on the server.
# PostHog:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://us.i.posthog.com/i
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20<phc_ token>
# Another backend for one signal:
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://otlp.example.com/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=
# OTEL_TRACES_EXPORTER=none
# The lowest log level the server logs: All, Trace, Debug, Info, Warn, Error, Fatal or None. Defaults to Info.
# LOG_LEVEL=Info
# Ren traces only the operations listed in packages/schema/src/observability.ts. TRACE_LEVEL=Debug traces every span,
# for local debugging or an incident.
# TRACE_LEVEL=Info
# Set to true to sign up without verifying the email. Only allowed when NODE_ENV is development or test.
# SKIP_EMAIL_VERIFICATION=true

# Google sign-in. Placeholders let the server start; create an OAuth client with the redirect URI
# http://localhost:4000/auth/callback/google to sign in with Google locally.
GOOGLE_CLIENT_ID=local-google-client-id
GOOGLE_CLIENT_SECRET=local-google-client-secret

# GitHub channel and Sign in with GitHub. Without GITHUB_APP_ID, GitHub is off. The App's webhook URL is
# <BETTER_AUTH_URL>/channels/github; its callback URLs are <BETTER_AUTH_URL>/channels/github/callback and
# <BETTER_AUTH_URL>/auth/callback/github. GITHUB_APP_PRIVATE_KEY is a PEM key or base64 of one.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_BOT_USER_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_WEBHOOK_SECRET=

# Slack channel and Sign in with Slack. Without SLACK_CLIENT_ID, Slack is off. The app's events URL is
# <BETTER_AUTH_URL>/channels/slack; its redirect URLs are <BETTER_AUTH_URL>/channels/slack/callback and
# <BETTER_AUTH_URL>/auth/oauth2/callback/slack.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=

# Transactional email via Postmark. Required unless NODE_ENV is development or test, where emails are logged instead.
# POSTMARK_SERVER_TOKEN=
# EMAIL_FROM=Ren <hello@example.com>
# Sender for invitation emails. Defaults to EMAIL_FROM.
# EMAIL_INVITE_FROM=Ren <invites@example.com>

# Session cells (packages/cell): the worker origin, and its signing keys as a JSON list of { id, secret }
# (secret at least 32 characters). The server signs with the first key. These point at the compose celld;
# copy packages/cell/.dev.vars.example to packages/cell/.dev.vars so it accepts the same key.
CELL_URL=http://127.0.0.1:9876
CELL_KEYS=[{"id":"local","secret":"local-development-cell-key-do-not-use-in-production"}]
# The largest file a message may carry, decoded. Defaults to 10MB.
# BRAIN_MAX_FILE_SIZE=10MB

# Sign-up guard. Disposable domains are always rejected; these lists (comma-separated) override the built-in list.
# SIGNUP_BLOCKED_DOMAINS=
# SIGNUP_ALLOWED_DOMAINS=
# Reject sign-ups from domains with no mail server (DNS lookup). Defaults to true.
# SIGNUP_MX_CHECK=false

# Drives: the S3 bucket of space and organization drives. Required. In development, RustFS in docker compose.
DRIVE_BUCKET=ren-drives
DRIVE_ENDPOINT=http://localhost:59000
DRIVE_ACCESS_KEY_ID=rendev
DRIVE_SECRET_ACCESS_KEY=ren-dev-secret
# The role Ren assumes to mint a brain's read-only drive keys. RustFS takes any ARN.
DRIVE_ROLE_ARN=arn:aws:iam::000000000000:role/drive
# DRIVE_REGION=us-east-1
# DRIVE_MAX_FILE_SIZE=100 MiB
