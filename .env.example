DATABASE_URL=postgres://ren:ren@localhost:54320/ren
PORT=4000
# development or test enables local-only shortcuts: logged emails and SKIP_EMAIL_VERIFICATION.
NODE_ENV=development

# Better Auth. Generate a real secret with `openssl rand -base64 32` for anything but local development.
BETTER_AUTH_SECRET=local-development-secret-do-not-use-in-production
BETTER_AUTH_URL=http://localhost:4000
# Comma-separated browser origins allowed to call the API with credentials (the app's dev server).
TRUSTED_ORIGINS=http://localhost:5173
# The app's URL including its /app base path, for links in emails (password reset, invitations).
APP_URL=http://localhost:5173/app
# Where the app finds the API at build time. Defaults to http://localhost:4000 in the dev server.
# VITE_REN_API_URL=http://localhost:4000
# Set to true to sign up without verifying the email. Only allowed when NODE_ENV is development or test.
# SKIP_EMAIL_VERIFICATION=true

# Google sign-in. Placeholders let the server start; create an OAuth client with the redirect URI
# http://localhost:4000/auth/callback/google to sign in with Google locally.
GOOGLE_CLIENT_ID=local-google-client-id
GOOGLE_CLIENT_SECRET=local-google-client-secret

# Transactional email via Postmark. Required unless NODE_ENV is development or test, where emails are logged instead.
# POSTMARK_SERVER_TOKEN=
# EMAIL_FROM=Ren <hello@example.com>
# Sender for invitation emails. Defaults to EMAIL_FROM.
# EMAIL_INVITE_FROM=Ren <invites@example.com>

# Session cells (packages/cell): the worker origin, and its signing keys as a JSON list of { id, secret }
# (secret at least 32 characters). The server signs with the first key. These point at the compose celld;
# copy packages/cell/.dev.vars.example to packages/cell/.dev.vars so it accepts the same key.
CELL_URL=http://127.0.0.1:9876
CELL_KEYS=[{"id":"local","secret":"local-development-cell-key-do-not-use-in-production"}]
# The largest file a message may carry, decoded. Defaults to 10MB.
# BRAIN_MAX_FILE_SIZE=10MB

# Sign-up guard. Disposable domains are always rejected; these lists (comma-separated) override the built-in list.
# SIGNUP_BLOCKED_DOMAINS=
# SIGNUP_ALLOWED_DOMAINS=
# Reject sign-ups from domains with no mail server (DNS lookup). Defaults to true.
# SIGNUP_MX_CHECK=false
