{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/ui": {
      "entry": ["src/components/*.tsx", "script/*.ts"],
      "project": ["src/**/*.{ts,tsx}", "script/**/*.ts", "test/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@fontsource/ibm-plex-mono"]
    },
    "packages/app": {
      "entry": ["src/routes/**/*.tsx", "src/platform/platform.tsx"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"],
      "ignore": ["src/route-tree.gen.ts"],
      "ignoreDependencies": ["tailwindcss"]
    }
  }
}
