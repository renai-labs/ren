{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["repos/**", "**/generated/**", "**/*.gen.ts"],
  "workspaces": {
    ".": {
      "entry": ["script/**/*.ts", "oxlint.config.ts", ".opencode/plugins/*.ts"],
      "ignoreDependencies": ["@opencode/plugin", "effect"]
    },
    "packages/*": {
      "entry": ["test/**/*.test.{ts,tsx}", "script/**/*.ts"]
    },
    "packages/storybook": {
      "entry": ["parity/*.stories.tsx", "test/**/*.test.{ts,tsx}", "script/**/*.ts"],
      "ignoreDependencies": ["@ren/app", "ren-v1"]
    },
    "packages/cell": {
      "entry": [
        "src/worker.ts",
        "test/lib/environment-worker.ts",
        "test/lib/sync-storage-worker.ts",
        "test/lib/crash-host.ts",
        "test/**/*.test.ts",
        "test/lib/preload.ts"
      ],
      "ignoreBinaries": ["celld"],
      "ignoreDependencies": ["cloudflare"]
    },
    "packages/core": {
      "entry": ["test/**/*.test.ts", "test/lib/preload.ts", "script/**/*.ts"]
    },
    "packages/db": {
      "entry": ["test/**/*.test.ts", "script/**/*.ts"],
      "ignoreDependencies": ["@ren/schema"]
    },
    "packages/e2e": {
      "entry": [
        "tests/**/*.spec.ts",
        "chaos/cases/*.test.ts",
        "chaos/lib/preload.ts",
        "chaos/lib/server-main.ts",
        "script/**/*.ts",
        "playwright.config.ts"
      ],
      "ignoreDependencies": ["@ren/server"]
    },
    "packages/httpapi-codegen": {
      "entry": ["test/**/*.test.ts", "script/**/*.ts"]
    }
  },
  "ignoreDependencies": [
    "tailwindcss",
    "@fontsource/ibm-plex-mono",
    "auth",
    "turbo",
    "prettier",
    "@typescript/native-preview"
  ],
  "ignoreIssues": {
    "packages/server/src/primitive.ts": ["duplicates"]
  }
}
