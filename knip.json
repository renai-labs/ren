{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["repos/**", "**/generated/**", "**/*.gen.ts", ".agents/**", ".claude/**"],
  "workspaces": {
    ".": {
      "entry": ["script/**/*.ts", "oxlint.config.ts", ".opencode/plugins/*.ts"],
      "ignoreDependencies": ["@opencode/plugin"]
    },
    "packages/*": {
      "entry": ["test/**/*.test.{ts,tsx}", "script/**/*.ts"]
    },
    "packages/cell": {
      "entry": [
        "src/worker.ts",
        "src/bun.ts",
        "e2b/stage.ts",
        "test/lib/environment-worker.ts",
        "test/lib/sync-storage-worker.ts",
        "test/lib/crash-host.ts",
        "test/lib/mcp-stdio.ts",
        "test/**/*.test.ts",
        "test/lib/preload.ts"
      ],
      "ignoreBinaries": ["celld", "e2b"],
      "ignoreDependencies": ["cloudflare"]
    },
    "packages/core": {
      "entry": ["test/**/*.test.ts", "test/lib/preload.ts", "script/**/*.ts"]
    },
    "packages/executor": {
      "entry": ["test/**/*.test.ts"],
      "ignoreBinaries": ["rclone", "fusermount3"]
    },
    "packages/db": {
      "entry": ["test/**/*.test.ts", "script/**/*.ts"],
      "ignoreDependencies": ["@ren/schema"]
    },
    "packages/e2e": {
      "entry": [
        "tests/**/*.spec.ts",
        "chaos/cases/*.test.ts",
        "chaos/lib/preload.ts",
        "chaos/lib/server-main.ts",
        "script/**/*.ts",
        "playwright.config.ts"
      ],
      "ignoreDependencies": ["@ren/server"]
    },
    "packages/site": {
      "entry": ["src/layouts/legal.astro"],
      "ignoreDependencies": ["react-dom", "@types/react-dom"]
    },
    "packages/httpapi-codegen": {
      "entry": ["test/**/*.test.ts", "script/**/*.ts"]
    },
    "packages/app": {
      "entry": ["src/main.tsx", "scripts/**/*.py"],
      "ignore": [
        "src/components/ui/**",
        "src/hooks/use-highlighted-code.ts",
        "src/hooks/use-mobile.ts",
        "src/lib/highlighter.tsx"
      ],
      "ignoreDependencies": [
        "shadcn",
        "tw-animate-css",
        "@fontsource/ibm-plex-mono",
        "@shadcn/react",
        "@streamdown/code",
        "cmdk",
        "input-otp",
        "react-day-picker",
        "shiki"
      ]
    }
  },
  "ignoreDependencies": ["tailwindcss", "@fontsource/ibm-plex-mono", "auth", "turbo", "@typescript/native-preview"],
  "ignoreIssues": {
    "packages/server/src/primitive.ts": ["duplicates"]
  }
}
