{
  "name": "artifact-state-candidate",
  "main": "_worker.js",
  "compatibility_date": "2026-06-01",
  "assets": { "directory": "public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "STATE", "class_name": "SampleState" }],
    "code_update_strategy": { "mode": "immediate" },
  },
  "exports": { "SampleState": { "type": "durable-object", "storage": "sqlite" } },
}
