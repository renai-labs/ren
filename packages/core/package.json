{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ren/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "generate": "bun run script/generate-auth-schema.ts",
    "check:generated": "bun run generate && git diff --exit-code -- ../db/src/auth.sql.ts",
    "test": "bun ../../script/test.ts",
    "typecheck": "tsgo -b tsconfig.json tsconfig.tests.json"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@ren/db": "workspace:*",
    "@ren/schema": "workspace:*",
    "@ren/util": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "free-email-domains": "catalog:",
    "tldts": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "auth": "catalog:",
    "prettier": "catalog:"
  }
}
