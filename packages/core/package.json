{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ren/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    "./testing": "./test/lib/testing.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "print-policies": "bun run script/print-policies.ts",
    "publish-apps": "bun run script/publish-apps.ts",
    "slack-manifest": "bun run script/slack-manifest.ts",
    "ren:settings": "bun run script/ren-settings.ts",
    "test": "bun ../../script/signoff/record.ts bun ../../script/changed.ts bun ../../script/test.ts",
    "test:cloudflare": "CELL_RUNTIME=wrangler bun ../../script/test.ts test/brain-host.test.ts test/hand-lifecycle.test.ts",
    "lint": "oxlint -c ../../oxlint.config.ts --disable-nested-config --type-aware --deny-warnings",
    "typecheck": "tsgo -b",
    "test:all": "bun ../../script/signoff/record.ts bun ../../script/test.ts",
    "test:opencode": "REN_SLOW=1 bun ../../script/test.ts test/opencode- test/restore.slow.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/client-sts": "catalog:",
    "@aws-sdk/s3-presigned-post": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@bufbuild/cel": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@noble/hashes": "catalog:",
    "@ren/db": "workspace:*",
    "@ren/hand-api": "workspace:*",
    "@ren/host-api": "workspace:*",
    "@ren/schema": "workspace:*",
    "@ren/telemetry": "workspace:*",
    "@ren/util": "workspace:*",
    "disposable-email-domains-js": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "slackify-markdown": "5.0.0",
    "standardwebhooks": "catalog:",
    "stripe": "catalog:",
    "wrangler": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@ren/cell": "workspace:*",
    "@ren/executor": "workspace:*",
    "@ren/opencode-transcript": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:"
  }
}
