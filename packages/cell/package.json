{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ren/cell",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    "./testing": "./test/lib/testing.ts",
    "./testing/brain": "./test/lib/brain.ts"
  },
  "scripts": {
    "deploy:celld": "celld deploy",
    "deploy:cloudflare": "wrangler deploy",
    "test": "bun ../../script/test.ts",
    "test:cloudflare": "CELL_RUNTIME=wrangler REN_SLOW=1 bun ../../script/test.ts test/cell.test.ts test/environment-lifecycle-cell.test.ts test/sync-storage.test.ts test/sync-storage.slow.test.ts",
    "lint": "oxlint -c ../../oxlint.config.ts --disable-nested-config --type-aware --deny-warnings",
    "typecheck": "tsgo -b",
    "template:e2b": "bun e2b/stage.ts"
  },
  "dependencies": {
    "@opencode/ai": "catalog:",
    "@opencode/client": "catalog:",
    "@opencode/core": "catalog:",
    "@opencode/plugin": "catalog:",
    "@opencode/schema": "catalog:",
    "@opencode/server": "catalog:",
    "@opencode/util": "catalog:",
    "@ren/brain": "workspace:*",
    "@ren/environment-api": "workspace:*",
    "@ren/host-api": "workspace:*",
    "@ren/opencode-transcript": "workspace:*",
    "@ren/protocol": "workspace:*",
    "@ren/schema": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@ren/executor": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "e2b": "2.19.4",
    "wrangler": "catalog:"
  }
}
