{
  // Must stay inside the subset that both celld and Cloudflare accept (specs/brain-host.md §7).
  // `name` and the `SessionCell` class name are permanent: celld keys cells by both.
  "name": "ren-cell-opencode",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "delete_all_deletes_alarm"],
  "durable_objects": {
    "bindings": [{ "name": "SESSION_CELL", "class_name": "SessionCell" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionCell"] }],
}
