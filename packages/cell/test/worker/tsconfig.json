{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["@cloudflare/workers-types"],
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "incremental": true,
    "noEmit": false,
    "outDir": "../../node_modules/.ts-dist/worker",
    "rootDir": ".",
    "tsBuildInfoFile": "../../node_modules/.ts-dist/worker.tsbuildinfo"
  },
  "include": ["."],
  "references": [{ "path": "../../tsconfig.worker.json" }]
}
