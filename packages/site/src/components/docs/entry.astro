---
import { DocsIcon } from "./icons.js"

type Props = { title: string; icon: string; href: string; badge?: string }
---

<a href={Astro.props.href} class="docs-entry">
  <span class="docs-entry-icon"><DocsIcon name={Astro.props.icon} /></span>
  <span class="docs-entry-title inline-flex flex-wrap items-center gap-1.5">
    {Astro.props.title}
    {
      Astro.props.badge && (
        <span class="rounded-full border border-fd-border bg-fd-muted px-1.5 py-0.5 text-[10px] leading-none font-medium text-fd-muted-foreground">
          {Astro.props.badge}
        </span>
      )
    }
  </span>
  <span class="docs-entry-body"><slot /></span>
</a>
