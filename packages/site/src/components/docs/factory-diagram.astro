---
import { LayerDiagram } from "../layer-diagram.js"
---

<figure class="not-prose my-8" aria-label="An organisation holds spaces, a space holds agents, and agents do chats and tasks">
  <LayerDiagram
    colors="[--diagram-fg:var(--color-fd-foreground)] [--diagram-muted:var(--color-fd-muted-foreground)]"
    viewBox="0 120 1030 320"
    layers={[
      {
        title: "Organisation",
        box: { x: 130, y: 150, width: 670, height: 260 },
        labels: ["Members", "Model providers", "Machines", "Billing"],
        labelsX: 160,
      },
      {
        title: "Space",
        box: { x: 370, y: 180, width: 410, height: 200 },
        labels: ["Drive", "Apps", "Repositories", "Automations"],
        labelsX: 400,
      },
      {
        title: "Agent",
        box: { x: 580, y: 210, width: 180, height: 140 },
        labels: ["Instructions", "Model", "Permissions"],
        labelsX: 610,
      },
    ]}
    start={{ text: "You", x: 20 }}
    end={{ text: "Chats & tasks", x: 890 }}
    arrows={[
      { x1: 62, x2: 150 },
      { x1: 316, x2: 390 },
      { x1: 528, x2: 600 },
    ]}
    dash={{ x1: 740, x2: 875 }}
  />
</figure>
