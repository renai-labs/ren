{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ren/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    ".": "./src/index.ts",
    "./effect": "./src/effect/index.ts",
    "./chat": "./src/chat/index.ts",
    "./chat/effect": "./src/chat/effect/index.ts",
    "./react": "./src/react/index.ts"
  },
  "scripts": {
    "generate": "bun run script/generate.ts",
    "check:generated": "bun run generate && git diff --exit-code -- src/generated src/effect/generated src/react/generated src/chat/generated src/chat/effect/generated",
    "test": "bun test --timeout 30000 --only-failures",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@ren/protocol": "workspace:*",
    "@ren/schema": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": "catalog:",
    "effect": "catalog:"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@ren/httpapi-codegen": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "effect": "catalog:"
  }
}
