{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ren/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "test": "bun ../../script/test.ts",
    "typecheck": "tsgo -b"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@ren/core": "workspace:*",
    "@ren/db": "workspace:*",
    "@ren/protocol": "workspace:*",
    "@ren/schema": "workspace:*",
    "@ren/util": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:"
  }
}
