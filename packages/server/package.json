{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ren/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    "./testing": "./test/lib/testing.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "generate": "bun run script/generate-auth-schema.ts",
    "check:generated": "bun run generate && git diff --exit-code -- ../db/src/auth.sql.ts",
    "dev": "bun --env-file=../../.env run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "test": "bun ../../script/test.ts",
    "typecheck": "tsgo -b"
  },
  "dependencies": {
    "@better-auth/cimd": "catalog:",
    "@better-auth/drizzle-adapter": "catalog:",
    "@better-auth/mcp": "catalog:",
    "@better-auth/oauth-provider": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@ren/host-api": "workspace:*",
    "@ren/core": "workspace:*",
    "@ren/db": "workspace:*",
    "@ren/egress-api": "workspace:*",
    "@ren/opencode-transcript": "workspace:*",
    "@ren/protocol": "workspace:*",
    "@ren/schema": "workspace:*",
    "@ren/util": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "free-email-domains": "catalog:",
    "tldts": "catalog:"
  },
  "devDependencies": {
    "@opencode/client": "catalog:",
    "@ren/brain": "workspace:*",
    "@ren/cell": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "auth": "catalog:",
    "jose": "catalog:",
    "prettier": "catalog:"
  }
}
