{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@renai-labs/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "ren2": "./src/index.ts"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "dev": "bun run src/index.ts",
    "generate": "bun run script/generate.ts",
    "test": "bun ../../script/test.ts",
    "lint": "oxlint -c ../../oxlint.config.ts --disable-nested-config --type-aware --deny-warnings",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@ren/schema": "workspace:*",
    "@renai-labs/sdk": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@ren/httpapi-codegen": "workspace:*",
    "@ren/protocol": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:"
  }
}
