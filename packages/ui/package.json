{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ren/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts"
  },
  "license": "UNLICENSED",
  "exports": {
    "./styles": "./src/styles/index.css",
    "./styles/fonts": "./src/styles/fonts.css",
    "./*": "./src/components/*.tsx"
  },
  "scripts": {
    "lint": "oxlint -c ../../oxlint.config.ts --disable-nested-config --type-aware --deny-warnings",
    "typecheck": "tsgo --noEmit",
    "generate": "bun run script/design-tokens.ts"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native-preview": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@fontsource/ibm-plex-mono": "catalog:",
    "@mdxeditor/editor": "catalog:",
    "@streamdown/cjk": "catalog:",
    "@streamdown/code": "catalog:",
    "@streamdown/math": "catalog:",
    "@streamdown/mermaid": "catalog:",
    "@tabler/icons-react": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cn": "catalog:",
    "input-otp": "catalog:",
    "react-day-picker": "catalog:",
    "shadcn": "catalog:",
    "streamdown": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
