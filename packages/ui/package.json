    "@pierre/diffs": "catalog:",
    "@pierre/trees": "catalog:",
    "@shadcn/react": "catalog:",
    "@tabler/icons-react": "catalog:",
    "class-variance-authority": "catalog:",
    "cmdk": "catalog:",
    "cn": "catalog:",
    "input-otp": "catalog:",
    "motion": "catalog:",
    "react-day-picker": "catalog:",
    "shadcn": "catalog:",
    "shiki": "catalog:",
    "sonner": "catalog:",
    "skullet": "catalog:",
    "tailwindcss": "catalog:",
