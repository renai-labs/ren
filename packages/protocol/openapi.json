  "components": {
    "schemas": {
      "Auth.Me": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/Auth.User"
          },
          "organization": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Auth.Organization"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["user", "organization"],
        "additionalProperties": false
      },
      "Auth.Organization": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Auth.OrganizationID"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "logo": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["id", "name", "slug"],
        "additionalProperties": false
      },
      "Auth.OrganizationID": {
        "type": "string",
        "pattern": "^org_"
      },
      "Auth.User": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Auth.UserID"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "image": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["id", "name", "email", "emailVerified"],
        "additionalProperties": false
      },
      "Auth.UserID": {
        "type": "string",
        "pattern": "^usr_"
      },
      "ConflictErrorEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": ["ConflictError"]
          },
          "message": {
            "type": "string"
          },
          "resource": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["_tag", "message"],
        "additionalProperties": false
      },
      "ForbiddenErrorEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": ["ForbiddenError"]
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["_tag", "message"],
        "additionalProperties": false
      },
      "Health.Info": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Health.Status"
          },
          "version": {
            "type": "string"
          }
        },
        "required": ["status", "version"],
        "additionalProperties": false
      },
      "Health.Status": {
        "anyOf": [
          {
            "type": "string",
            "enum": ["ok"]
          }
        ]
      },
      "Invitation.Preview": {
        "type": "object",
        "properties": {
          "state": {
            "$ref": "#/components/schemas/Invitation.State"
          },
          "organization": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/components/schemas/Auth.OrganizationID"
                  },
                  "name": {
                    "type": "string"
                  },
                  "logo": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["id", "name", "logo"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "inviter": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "email": {
                    "type": "string"
                  }
                },
                "required": ["name", "email"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["state", "organization", "inviter"],
        "additionalProperties": false
      },
      "Invitation.State": {
        "type": "string",
        "enum": ["pending", "expired", "accepted", "unavailable", "invalid"]
      },
      "NotFoundErrorEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": ["NotFoundError"]
          },
          "message": {
            "type": "string"
          },
          "resource": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["_tag", "message"],
        "additionalProperties": false
      },
      "Space.AssignmentID": {
        "type": "string",
        "pattern": "^spp_"
      },
      "Space.CreateInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
            "minLength": 1,
            "maxLength": 256
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["name"],
        "additionalProperties": false
      },
      "Space.ID": {
        "type": "string",
        "pattern": "^spc_"
      },
      "Space.Info": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Space.ID"
          },
          "organizationId": {
            "$ref": "#/components/schemas/Auth.OrganizationID"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "memberCount": {
            "type": "integer"
          },
          "membershipId": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Space.MembershipID"
              },
              {
                "type": "null"
              }
            ]
          },
          "canManage": {
            "type": "boolean"
          },
          "canArchive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "archivedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "organizationId",
          "name",
          "description",
          "memberCount",
          "membershipId",
          "canManage",
          "canArchive",
          "createdAt",
          "updatedAt",
          "archivedAt"
        ],
        "additionalProperties": false
      },
      "Space.MembershipID": {
        "type": "string",
        "pattern": "^spm_"
      },
      "Space.Page": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Space.Info"
            }
          },
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
