{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ren/mobile",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "main": "index.ts",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#features/*": "./src/features/*.tsx",
    "#lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "start": "APP_VARIANT=development expo start --dev-client",
    "android": "APP_VARIANT=development expo run:android",
    "ios": "APP_VARIANT=development expo run:ios",
    "build:android:internal": "bunx eas-cli build --local --platform android --profile internal --output ./ren-internal.apk",
    "build:android:production": "bunx eas-cli build --local --platform android --profile production --output ./ren-production.aab",
    "submit:android": "bunx eas-cli submit --platform android --profile production --path ./ren-production.aab",
    "update:internal": "APP_VARIANT=production EXPO_PUBLIC_REN_URL=https://api.useren.ai EXPO_PUBLIC_REN_APP_URL=https://useren.ai/app EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH=1 EXPO_UNSTABLE_TREE_SHAKING=1 bunx eas-cli update --environment production --channel internal",
    "update:production": "APP_VARIANT=production EXPO_PUBLIC_REN_URL=https://api.useren.ai EXPO_PUBLIC_REN_APP_URL=https://useren.ai/app EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH=1 EXPO_UNSTABLE_TREE_SHAKING=1 bunx eas-cli update --environment production --channel production",
    "generate": "bun run script/theme.ts",
    "check:bundle": "expo export --platform ios --platform android --output-dir node_modules/.cache/expo-export",
    "check:doctor": "bunx expo-doctor",
    "check:generated": "bun run generate && git diff --exit-code -- src/theme.gen.css",
    "lint": "oxlint -c ../../oxlint.config.ts --disable-nested-config --type-aware --deny-warnings",
    "typecheck": "tsgo -b"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@effect/atom-react": "catalog:",
    "@expo-google-fonts/ibm-plex-mono": "catalog:",
    "@expo-google-fonts/inter": "catalog:",
    "@expo/metro-runtime": "catalog:",
    "@legendapp/list": "catalog:",
    "@ren/chat": "workspace:*",
    "@ren/client": "workspace:*",
    "@ren/schema": "workspace:*",
    "@ren/util": "workspace:*",
    "@rn-primitives/slot": "catalog:",
    "@tabler/icons-react-native": "catalog:",
    "@tanstack/react-query": "catalog:",
    "better-auth": "catalog:",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "effect": "catalog:",
    "expo": "catalog:",
    "expo-clipboard": "catalog:",
    "expo-constants": "catalog:",
    "expo-crypto": "catalog:",
    "expo-dev-client": "catalog:",
    "expo-document-picker": "catalog:",
    "expo-file-system": "catalog:",
    "expo-font": "catalog:",
    "expo-image-picker": "catalog:",
    "expo-linking": "catalog:",
    "expo-network": "catalog:",
    "expo-router": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-sharing": "catalog:",
    "expo-splash-screen": "catalog:",
    "expo-sqlite": "catalog:",
    "expo-status-bar": "catalog:",
    "expo-system-ui": "catalog:",
    "expo-updates": "catalog:",
    "expo-web-browser": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-drawer-layout": "catalog:",
    "react-native-enriched-markdown": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-heroicons": "catalog:",
    "react-native-keyboard-controller": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-svg": "catalog:",
    "react-native-worklets": "catalog:",
    "tailwindcss": "catalog:",
    "uniwind": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "~6.0.3"
  }
}
