{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ren/mobile",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "main": "index.ts",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "build:android:internal": "bunx eas-cli build --local --platform android --profile internal --output ./ren-internal.apk",
    "generate": "bun run script/theme.ts",
    "check:generated": "bun run generate && git diff --exit-code -- src/theme.gen.css",
    "lint": "oxlint -c ../../oxlint.config.ts --disable-nested-config --type-aware --deny-warnings",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@effect/atom-react": "catalog:",
    "@expo-google-fonts/ibm-plex-mono": "catalog:",
    "@expo-google-fonts/inter": "catalog:",
    "@expo/metro-runtime": "catalog:",
    "@legendapp/list": "catalog:",
    "@ren/chat": "workspace:*",
    "@ren/client": "workspace:*",
    "@ren/schema": "workspace:*",
    "@ren/util": "workspace:*",
    "@rn-primitives/slot": "catalog:",
    "@tabler/icons-react-native": "catalog:",
    "@tanstack/react-query": "catalog:",
    "better-auth": "catalog:",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "effect": "catalog:",
    "expo": "catalog:",
    "expo-constants": "catalog:",
    "expo-crypto": "catalog:",
    "expo-dev-client": "catalog:",
    "expo-font": "catalog:",
    "expo-linking": "catalog:",
    "expo-network": "catalog:",
    "expo-router": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-splash-screen": "catalog:",
    "expo-sqlite": "catalog:",
    "expo-status-bar": "catalog:",
    "expo-system-ui": "catalog:",
    "expo-web-browser": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-drawer-layout": "catalog:",
    "react-native-enriched-markdown": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-keyboard-controller": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
