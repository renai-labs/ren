      "type": "text",
      "x": 10,
      "y": 910,
      "width": 1970,
      "height": 140,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "roundness": null,
      "boundElements": [],
      "text": "Core flows\n1 Create   app → Session.create → [A] brain of the space (create if none) → [D] BrainHost.start → sandbox create / resume → /ren/sessions start\n2 Open     app → Session.access → [E] brain running? session present? else restore from Postgres → {url, client token [C]}\n3 Turn     app → /chat/* prompt → OpenCode → model [F] → events stream back to the app over /chat/*\n4 Sync     Scheduler → sync step → /host sync ingest → Postgres (each session of the brain)\n5 Idle     every session of the brain idle → [D] pause the sandbox · next call wakes it\n6 Lost     sandbox gone → [D] new sandbox, next generation → [E] restore sessions from Postgres on access / start",
      "originalText": "Core flows\n1 Create   app → Session.create → [A] brain of the space (create if none) → [D] BrainHost.start → sandbox create / resume → /ren/sessions start\n2 Open     app → Session.access → [E] brain running? session present? else restore from Postgres → {url, client token [C]}\n3 Turn     app → /chat/* prompt → OpenCode → model [F] → events stream back to the app over /chat/*\n4 Sync     Scheduler → sync step → /host sync ingest → Postgres (each session of the brain)\n5 Idle     every session of the brain idle → [D] pause the sandbox · next call wakes it\n6 Lost     sandbox gone → [D] new sandbox, next generation → [E] restore sessions from Postgres on access / start",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "el41",
      "autoResize": true,
      "lineHeight": 1.25
    }
