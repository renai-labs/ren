{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "globalDependencies": [
    "patches/**",
    "tsconfig.base.json",
    "bunfig.toml",
    ".github/actions/setup-bun/**"
  ],
  "globalEnv": ["CI", "REN_SLOW"],
  "globalPassThroughEnv": ["CI", "DATABASE_URL"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/script/test.ts", "$TURBO_ROOT$/packages/test-harness/src/**"],
      "env": ["CELL_RUNTIME", "REN_TEST_PROFILE", "REN_TEST_BUDGET_MIB", "REN_TEST_MEMORY_MIB"],
      "outputs": []
    },
    "@ren/e2e#test": {
      "outputs": [],
      "cache": false
    }
  }
}
