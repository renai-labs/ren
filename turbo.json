{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["patches/**", "bunfig.toml", ".github/actions/setup-bun/**", ".github/workflows/test.yml"],
  "globalEnv": ["CI"],
  "globalPassThroughEnv": ["CI", "DATABASE_URL"],
  "tasks": {
    "typecheck": {},
    "@ren/server#typecheck": {
      "dependsOn": ["@ren/core#typecheck"]
    },
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@ren/e2e#test": {
      "outputs": [],
      "cache": false
    }
  }
}
