{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["patches/**", "tsconfig.base.json", "bunfig.toml", ".github/actions/setup-bun/**"],
  "globalEnv": ["CI", "REN_SLOW"],
  "globalPassThroughEnv": ["CI", "DATABASE_URL", "REN_MEMORY_LEASE"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["node_modules/.ts-dist/**"]
    },
    "//#typecheck:root": {
      "dependsOn": ["@ren/test-harness#typecheck"],
      "inputs": ["script/**", "tsconfig.json"],
      "outputs": ["node_modules/.ts-dist/**"]
    },
    "build": {
      "dependsOn": ["transit"],
      "outputs": ["dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "//#lint:root": {
      "inputs": ["$TURBO_DEFAULT$", "!docs/**", "!specs/**", "!**/*.md"],
      "outputs": []
    },
    "//#lint:rules": {
      "inputs": [
        "packages/**/*.{ts,tsx}",
        "script/**",
        "!**/node_modules/**",
        "!**/generated/**",
        "!**/*.gen.ts",
        "!packages/e2e/.runs/**",
        "!**/.astro/**"
      ],
      "outputs": []
    },
    "//#lint:unused": {
      "inputs": ["$TURBO_DEFAULT$", "!docs/**", "!specs/**", "!**/*.md"],
      "outputs": []
    },
    "//#format:check": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "@ren/mobile#check:bundle": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!maestro/**",
        "!**/*.md",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "env": ["EXPO_PUBLIC_*"],
      "outputs": []
    },
    "@ren/mobile#check:bundle:fast": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!maestro/**",
        "!**/*.md",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "env": ["EXPO_PUBLIC_*"],
      "outputs": []
    },
    "@ren/mobile#check:generated": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/ui/src/styles/index.css"],
      "outputs": []
    },
    "@ren/mobile#check:doctor": {
      "cache": false
    },
    "@ren/e2e#test": {
      "outputs": [],
      "cache": false
    },
    "@ren/site#check:routes": {
      "inputs": ["src/pages/**", "script/check-routes.ts", "$TURBO_ROOT$/infra/aws/app.tf"],
      "outputs": []
    },
    "@ren/app#build": {
      "dependsOn": ["transit"],
      "env": ["VITE_*"],
      "outputs": ["dist/**"]
    },
    "@ren/site#build": {
      "dependsOn": ["transit"],
      "env": ["PUBLIC_*"],
      "outputs": ["dist/**"]
    },
    "test:all": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/script/test.ts", "$TURBO_ROOT$/packages/test-harness/src/**"],
      "env": ["CELL_RUNTIME", "REN_TEST_PROFILE", "REN_TEST_MEMORY_MIB", "REN_TEST_WORKERS"],
      "outputs": [],
      "passThroughEnv": ["REN_MEMORY_BUDGET_MIB", "REN_MEMORY_FLOOR_MIB", "REN_MEMORY_RESERVE_MIB"]
    },
    "test:opencode": {
      "dependsOn": ["^build"],
      "env": ["CELL_RUNTIME", "REN_TEST_PROFILE", "REN_TEST_MEMORY_MIB", "REN_TEST_WORKERS"],
      "passThroughEnv": ["REN_MEMORY_BUDGET_MIB", "REN_MEMORY_FLOOR_MIB", "REN_MEMORY_RESERVE_MIB"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["REN_MEMORY_BUDGET_MIB", "REN_MEMORY_FLOOR_MIB", "REN_MEMORY_RESERVE_MIB"],
      "cache": false
    }
  }
}
