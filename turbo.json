{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["patches/**", "tsconfig.base.json", "bunfig.toml", ".github/actions/setup-bun/**"],
  "globalEnv": ["CI", "REN_SLOW"],
  "globalPassThroughEnv": ["CI", "DATABASE_URL", "REN_MEMORY_LEASE"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["node_modules/.ts-dist/**"]
    },
    "//#typecheck:root": {
      "dependsOn": ["@ren/test-harness#typecheck"],
      "inputs": ["script/**", "tsconfig.json"],
      "outputs": ["node_modules/.ts-dist/**"]
    },
    "build": {
      "dependsOn": ["transit"],
      "outputs": ["dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/oxlint.config.ts", "$TURBO_ROOT$/script/oxlint/**"],
      "outputs": []
    },
    "//#lint:root": {
      "dependsOn": ["//#typecheck:root"],
      "inputs": ["script/**", "oxlint.config.ts", "tsconfig.json"],
      "outputs": []
    },
    "//#lint:rules": {
      "inputs": ["packages/**/*.{ts,tsx}", "script/**", "!**/node_modules/**", "!**/generated/**", "!**/*.gen.ts"],
      "outputs": []
    },
    "//#lint:unused": {
      "inputs": [
        "packages/**",
        "script/**",
        "knip.json",
        "package.json",
        "bun.lock",
        "oxlint.config.ts",
        ".opencode/plugins/**",
        "!**/node_modules/**"
      ],
      "outputs": []
    },
    "//#format:check": {
      "inputs": ["**", "!**/node_modules/**", "!.turbo/**"],
      "outputs": []
    },
    "@ren/e2e#test": {
      "outputs": [],
      "cache": false
    },
    "@ren/app#build": {
      "dependsOn": ["transit"],
      "env": ["VITE_*"],
      "outputs": ["dist/**"]
    },
    "@ren/site#build": {
      "dependsOn": ["transit"],
      "env": ["PUBLIC_*"],
      "outputs": ["dist/**"]
    },
    "test:all": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/script/test.ts", "$TURBO_ROOT$/packages/test-harness/src/**"],
      "env": ["CELL_RUNTIME", "REN_TEST_PROFILE", "REN_TEST_MEMORY_MIB", "REN_TEST_WORKERS"],
      "outputs": [],
      "passThroughEnv": ["REN_MEMORY_BUDGET_MIB", "REN_MEMORY_FLOOR_MIB", "REN_MEMORY_RESERVE_MIB"]
    },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["REN_MEMORY_BUDGET_MIB", "REN_MEMORY_FLOOR_MIB", "REN_MEMORY_RESERVE_MIB"],
      "cache": false
    }
  }
}
