{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "globalDependencies": [
    "patches/**",
    "tsconfig.base.json",
    "bunfig.toml",
    ".github/actions/setup-bun/**",
    ".github/workflows/test.yml"
  ],
  "globalEnv": ["CI"],
  "globalPassThroughEnv": ["CI", "DATABASE_URL"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@ren/e2e#test": {
      "outputs": [],
      "cache": false
    }
  }
}
