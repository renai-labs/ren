{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "ren",
  "description": "Agent infrastructure platform for AI-native teams",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run --cwd packages/server dev",
    "dev:app": "bun run --cwd packages/app dev",
    "dev:site": "bun run --cwd packages/site dev",
    "dev:storybook": "bun run --cwd packages/storybook dev",
    "print-policies": "bun run --cwd packages/core print-policies",
    "ren:settings": "bun run --cwd packages/core ren:settings",
    "lint": "oxlint --disable-nested-config --type-aware --deny-warnings && ast-grep scan -c script/ast-grep/sgconfig.yml --globs '!**/generated/**' --globs '!**/*.gen.ts' --globs '!packages/db/src/auth.sql.ts' packages script && knip --no-config-hints",
    "typecheck": "bun turbo typecheck --concurrency=3 && tsgo --noEmit",
    "check": "bun run lint && bun run typecheck",
    "generate": "bun run script/generate.ts",
    "keys": "bun run packages/schema/script/keys.ts",
    "format": "bun run script/format.ts",
    "prepare": "husky",
    "test": "echo 'do not run tests from root' && exit 1"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "repos/iron-proxy"
    ],
    "catalog": {
      "@astrojs/check": "0.9.10",
      "@astrojs/starlight": "0.42.5",
      "@axe-core/playwright": "4.13.0",
      "@babel/core": "7.29.7",
      "@base-ui/react": "1.8.0",
      "@better-auth/cimd": "1.7.7",
      "@better-auth/drizzle-adapter": "1.7.7",
      "@better-auth/mcp": "1.7.7",
      "@better-auth/oauth-provider": "1.7.7",
      "@cloudflare/workers-types": "5.20261010.1",
      "@daypicker/react": "10.0.2",
      "@effect/atom-react": "4.0.1",
      "@effect/platform-bun": "4.0.1",
      "@effect/sql-pg": "4.0.1",
      "@modelcontextprotocol/client": "2.0.0",
      "@fontsource/ibm-plex-mono": "5.3.0",
      "@mdxeditor/editor": "4.2.0",
      "@opencode/ai": "2.0.27",
      "@opencode/client": "2.0.27",
      "@opencode/core": "2.0.27",
      "@opencode/plugin": "2.0.27",
      "@opencode/schema": "2.0.27",
      "@opencode/server": "2.0.27",
      "@opencode/util": "2.0.27",
      "@playwright/test": "1.63.0",
      "@rolldown/plugin-babel": "0.2.4",
      "@storybook/react-vite": "10.6.1",
      "@streamdown/cjk": "1.0.4",
      "@streamdown/code": "2.0.0",
      "@streamdown/math": "1.0.3",
      "@streamdown/mermaid": "1.0.3",
      "@tabler/icons-react": "3.49.0",
      "@tailwindcss/vite": "4.3.3",
      "@tanstack/react-form": "1.33.5",
      "@tanstack/react-query": "5.104.1",
      "@tanstack/react-router": "1.170.41",
      "@tanstack/react-virtual": "3.14.13",
      "@tanstack/router-cli": "1.167.40",
      "@tanstack/router-plugin": "1.168.42",
      "@tsconfig/bun": "1.0.11",
      "@types/babel__core": "7.20.5",
      "@types/bun": "1.4.2",
      "@types/node": "26.6.4",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@typescript/native-preview": "7.0.0-dev.20260707.2",
      "@vitejs/plugin-react": "6.1.2",
      "astro": "7.3.6",
      "auth": "1.7.7",
      "babel-plugin-react-compiler": "1.0.0",
      "better-auth": "1.7.7",
      "class-variance-authority": "0.7.1",
      "clsx": "2.1.1",
      "diff": "8.0.4",
      "disposable-email-domains-js": "1.26.0",
      "drizzle-kit": "1.0.0-rc.5-5935859",
      "drizzle-orm": "1.0.0-rc.5-5935859",
      "effect": "4.0.1",
      "free-email-domains": "1.12.21",
      "jose": "6.2.12",
      "prettier": "3.9.9",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "storybook": "10.6.1",
      "streamdown": "2.7.0",
      "tailwind-merge": "3.7.0",
      "tailwindcss": "4.3.3",
      "tldts": "7.4.18",
      "typescript": "5.9.3",
      "ulid": "3.0.2",
      "vite": "8.3.3",
      "wrangler": "4.149.0"
    }
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@oxlint/plugins": "1.87.0",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "eslint-plugin-better-tailwindcss": "4.9.0",
    "husky": "9.1.7",
    "knip": "6.40.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "catalog:",
    "turbo": "2.11.7"
  },
  "trustedDependencies": [
    "@ast-grep/cli",
    "esbuild"
  ],
  "overrides": {
    "effect": "catalog:",
    "@types/bun": "catalog:"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120
  }
}
