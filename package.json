{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "ren",
  "description": "Agent infrastructure platform for AI-native teams",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "scripts": {
    "dev": "bun run --cwd packages/server dev",
    "dev:app": "bun run --cwd packages/app dev",
    "dev:site": "bun run --cwd packages/site dev",
    "print-policies": "bun run --cwd packages/core print-policies",
    "ren:settings": "bun run --cwd packages/core ren:settings",
    "lint": "bun script/signoff/record.ts bun script/memory.ts queue --mib=2048 --units=3 -- bun run lint:all",
    "lint:all": "bun turbo lint:root lint:rules lint:unused format:check @ren/mobile#check:generated @ren/site#check:routes --output-logs=errors-only",
    "typecheck": "bun script/signoff/record.ts bun script/memory.ts queue --mib=2048 --units=3 -- bun run typecheck:all",
    "typecheck:all": "bun turbo typecheck typecheck:root @ren/mobile#check:bundle --output-logs=errors-only",
    "check": "bun script/memory.ts queue --mib=2048 --units=3 -- bun run script/check.ts",
    "generate": "bun run script/generate.ts",
    "test:opencode": "bun turbo test:opencode --concurrency=1 --continue",
    "opencode:bump": "bun run script/opencode-bump.ts",
    "opencode:record": "bun run --cwd packages/cell opencode:record && bun fmt packages/opencode-transcript/test/fixtures packages/cell/test/fixtures/databases",
    "memory": "bun script/memory.ts",
    "keys": "bun run packages/schema/script/keys.ts",
    "format": "bun run script/format.ts",
    "prepare": "husky && if [ -d .husky/_ ]; then cp .husky/reference-transaction .husky/_/reference-transaction; fi",
    "test": "bun run script/test-changed.ts",
    "lint:root": "bun script/lint.ts",
    "lint:rules": "ast-grep scan -c script/ast-grep/sgconfig.yml --globs '!**/generated/**' --globs '!**/*.gen.ts' --globs '!packages/db/src/auth.sql.ts' packages script",
    "lint:unused": "knip --no-config-hints",
    "format:check": "bun fmt --check",
    "typecheck:root": "tsrs -b",
    "check:all": "bun script/opencode-lock.ts && bun run typecheck && bun run lint",
    "test:all": "bun turbo test:all --output-logs=errors-only"
  },
